# Copied to .dev.vars for local `wrangler dev`. Never set DEV_IDENTITY in production.
STUDIO_OWNER_EMAIL=PUT_YOUR_REAL_EMAIL_HERE
DEV_IDENTITY=PUT_YOUR_REAL_EMAIL_HERE

# Online payments. `wrangler secret put` only affects the deployed Worker;
# for local `wrangler dev`, values come from here instead. Use your Xendit
# and PayPal *sandbox* keys, never live ones, in this file.
XENDIT_SECRET_KEY=PUT_YOUR_XENDIT_TEST_SECRET_KEY
XENDIT_WEBHOOK_TOKEN=PUT_YOUR_XENDIT_WEBHOOK_VERIFICATION_TOKEN
PAYPAL_CLIENT_ID=PUT_YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=PUT_YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=PUT_YOUR_PAYPAL_SANDBOX_WEBHOOK_ID

# Notification email. Optional: leave unset and every notification call
# silently does nothing. Also needs Settings > Notification email set in
# the studio itself, since that's where the "send to" address comes from.
RESEND_API_KEY=PUT_YOUR_RESEND_API_KEY
