# "mock" uses in-browser data from src/data/mock. "live" calls the Worker API.
VITE_API_MODE=mock

# Hostnames ending in this domain use subdomain routing. Anything else uses path routing.
VITE_ROOT_DOMAIN=villoguides.com

# Contact address shown on the brand page and the coming soon page.
VITE_CONTACT_EMAIL=hello@villoguides.com
